@book{ahnertNetworkTurnChanging2021,
  title = {The {{Network Turn}}: {{Changing Perspectives}} in the {{Humanities}}},
  shorttitle = {The {{Network Turn}}},
  author = {Ahnert, Ruth and Ahnert, Sebastian E. and Coleman, Catherine Nicole and Weingart, Scott B.},
  year = 2021,
  month = jan,
  edition = {1},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781108866804},
  urldate = {2025-07-06},
  abstract = {We live in a networked world. Online social networking platforms and the World Wide Web have changed how society thinks about connectivity. Because of the technological nature of such networks, their study has predominantly taken place within the domains of computer science and related scientific fields. But arts and humanities scholars are increasingly using the same kinds of visual and quantitative analysis to shed light on aspects of culture and society hitherto concealed. This Element contends that networks are a category of study that cuts across traditional academic barriers, uniting diverse disciplines through a shared understanding of complexity in our world. Moreover, we are at a moment in time when it is crucial that arts and humanities scholars join the critique of how large-scale network data and advanced network analysis are being harnessed for the purposes of power, surveillance, and commercial gain. This title is also available as Open Access on Cambridge Core.},
  copyright = {https://www.cambridge.org/core/terms},
  isbn = {978-1-108-86680-4 978-1-108-79190-8},
  langid = {english},
  keywords = {Language Arts & Disciplines / Publishing,Literary Criticism / General,Literary Criticism / Reference,Literary Criticism / Semiotics & Theory},
  file = {C:\Users\You\Zotero\storage\FNXA8W4I\Ahnert et al. - 2020 - The Network Turn Changing Perspectives in the Humanities.pdf}
